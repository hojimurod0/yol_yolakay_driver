<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release/profile: HTTPS only. Debug builds override this file from
         src/debug/res/xml to allow the local emulator backend. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
